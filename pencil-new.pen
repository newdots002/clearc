                  "children": [
                    {
                      "type": "text",
                      "id": "ZUMoJ",
                      "name": "faq2QCn",
                      "fill": "#FFFFFF",
                      "content": "删除这些文件安全吗？",
                      "fontFamily": "Inter",
                      "fontSize": 16,
                      "fontWeight": "600"
                    },
                    {
                      "type": "text",
                      "id": "11P1L",
                      "name": "faq2ACn",
                      "fill": "#64748B",
                      "textGrowth": "fixed-width",
                      "width": 752,
                      "content": "完全安全！ClearC 只清理可重新生成的缓存和构建文件。您的源代码和重要数据都受到保护。这些文件在需要时可以随时重新构建。",
                      "lineHeight": 1.6,
                      "fontFamily": "Inter",
                      "fontSize": 14
                    }
                  ]
                },
